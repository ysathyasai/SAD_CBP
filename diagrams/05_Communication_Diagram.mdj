											"width": 1350,
											"height": 22,
											"text": "Object Collaboration Graph Illustrating Hierarchical Message Sequences across Placement (1.x), Status Update (2.x), and Tracking (3.x)"
										},
										{
											"_type": "RectangleView",
											"_id": "V_LGD_15AA83088DA34BBA",
