										{
											"_type": "UMLTextView",
											"_id": "TXT_LGD_TIT_C4A441BEF3FC42F2",
											"_parent": {
												"$ref": "DIAG_7CA76D47D6694AEA"
											},
											"fontColor": "#111827",
											"font": "Arial;11;1",
											"parentStyle": false,
											"left": 55,
											"top": 690,
											"width": 600,
											"height": 23,
											"text": "YieldGrid Object Collaboration & Message Sequence Policies"
										},
										{
											"_type": "UMLTextView",
											"_id": "TXT_LGD_BODY_5C18BF78FEA1476F",
											"_parent": {
												"$ref": "DIAG_7CA76D47D6694AEA"
											},
											"fontColor": "#374151",
											"font": "Arial;10;0",
											"parentStyle": false,
											"left": 55,
											"top": 715,
											"width": 1350,
											"height": 130,
											"text": "• Phase 1 (1 to 1.9): Customer initiates checkout in CartPanel; OrderService verifies fresh live stock with CropDAO; OrderDAO coordinates with DBConnection to execute JDBC transaction (setAutoCommit(false)), inserts order header, inserts line items, decrements stock atomically, and commits.\n• Phase 2 (2 to 2.7): Farmer accesses OrdersPanel; retrieves assigned orders via OrderService and OrderDAO; updates order status to CONFIRMED/COMPLETED/CANCELLED, persisting change to MySQL and refreshing table view.\n• Phase 3 (3 to 3.4): Customer switches to OrdersPanel history tab; asynchronous query retrieves placed orders and live status from MySQL database, rendering the tracked lifecycle state in the GUI table."
										},
