										},
										{
											"_type": "UMLTextView",
											"_id": "TXT_LGD_TIT_C120B3F05C084F8B",
											"_parent": {
												"$ref": "DIAG_50D522F2B7F542F6"
											},
											"fontColor": "#111827",
											"font": "Arial;12;1",
											"parentStyle": false,
											"left": 70,
											"top": 625,
											"width": 600,
											"height": 24,
											"text": "YieldGrid Order Transition Policies & Database Integration Notes"
										},
										{
											"_type": "UMLTextView",
											"_id": "TXT_LGD_BODY_B4A99E1DBECD4F97",
											"_parent": {
												"$ref": "DIAG_50D522F2B7F542F6"
											},
											"fontColor": "#374151",
											"font": "Arial;11;0",
											"parentStyle": false,
											"left": 70,
											"top": 650,
											"width": 1300,
											"height": 110,
											"text": "• PENDING: Initial state upon checkout. OrderDAO atomically debits live crop inventory within an ACID transaction (conn.setAutoCommit(false)).\n• CONFIRMED: Farmer reviews incoming orders in OrdersPanel and accepts fulfillment. Crop batch is reserved and prepared for customer distribution.\n• COMPLETED: Order successfully delivered/received. Farmer triggers update in OrdersPanel; OrderDAO marks status COMPLETED, activating revenue calculation.\n• CANCELLED: Rejection by farmer (e.g. crop damage/spoilage) or pre-confirmation cancellation. OrderDAO releases reserved quantity back to crop inventory."
										},
